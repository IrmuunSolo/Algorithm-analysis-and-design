//  Гэхдээ нэгэн зэрэг олон хувьцаа барьж болохгүй
//  → (заавал зарсны дараа л дараагийн удаа авна)
//  Зорилго: нийт ашгийг хамгийн их болго.
//
//        Алгоритм:
//  profit = 0
