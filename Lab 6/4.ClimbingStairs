// Bottom-up, Dynamic programming буюу бүх дэд бодлогын шийдийг бусад дэд бодлогод ашиглана

class Solution {
    public int climbStairs(int n) {
        if (n <= 2) return n;

        int a = 1;      // dp[1]
        int b = 2;      // dp[2]

        for (int i = 3; i <= n; i++) {
            int c = a + b;      // dp[i] = dp[i-1] + dp[i-2]
            a = b;
            b = c;
        }

        return b;
    }
}
